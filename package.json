{
  "name": "create-api-starterkit",
  "version": "1.0.0",
  "description": "Scaffold a production-ready Node.js + TypeScript + Express API with a single command",
  "type": "module",
  "bin": {
    "create-api-starterkit": "./dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "create",
    "api",
    "starterkit",
    "scaffold",
    "express",
    "typescript",
    "nodejs",
    "boilerplate",
    "template",
    "cli"
  ],
  "author": "SibilSoren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SibilSoren/create-api-starterkit.git"
  },
  "bugs": {
    "url": "https://github.com/SibilSoren/create-api-starterkit/issues"
  },
  "homepage": "https://github.com/SibilSoren/create-api-starterkit#readme",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "vitest": "^3.1.3",
    "eslint": "^9.25.0",
    "@eslint/js": "^9.25.0",
    "typescript-eslint": "^8.30.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
